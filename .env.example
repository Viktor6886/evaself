# =====================================================================
# Evaself — environment template
# ---------------------------------------------------------------------
# `make install` generates a real .env from this template by asking the
# operator for the values marked REQUIRED and generating every secret
# marked GENERATED. The generated file is chmod 600 and is NEVER
# committed to git (see .gitignore).
#
# Copy manually only if you know what you are doing:
#   cp .env.example .env && chmod 600 .env
# =====================================================================

# ---------------------------------------------------------------------
# 1. DOMAINS  (REQUIRED — asked during install, no hard-coded defaults)
# ---------------------------------------------------------------------
# The installer asks for DOMAIN first, then proposes every sub-domain
# below as "<prefix>.<DOMAIN>" and lets the operator change each one.
DOMAIN=
DOMAIN_APP=
DOMAIN_API=
DOMAIN_N8N=
DOMAIN_NOCODB=
DOMAIN_LETTA=
DOMAIN_STATUS=

# E-mail used by Caddy for Let's Encrypt / ZeroSSL account registration.
ACME_EMAIL=

# Set to 1 to use the Let's Encrypt staging CA (for testing DNS/ports
# without burning rate limits). 0 = production certificates.
ACME_STAGING=0

# ---------------------------------------------------------------------
# 2. TELEGRAM  (REQUIRED)
# ---------------------------------------------------------------------
# Eva's user-facing bot. Used by the n8n Telegram trigger + Eva WebApp.
EVA_TELEGRAM_BOT_TOKEN=
# Separate bot used ONLY by the Hermes server agent.
HERMES_TELEGRAM_BOT_TOKEN=
# Numeric Telegram ID of the owner. Hermes accepts commands from this
# ID and no one else.
OWNER_TELEGRAM_ID=
# Shared secret for Telegram webhook verification (GENERATED).
EVA_TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# 3. LLM FOR EVA  (REQUIRED)
# ---------------------------------------------------------------------
# Any OpenAI-compatible endpoint. Consumed by Letta (as an OpenAI-proxy
# provider) and by Eva Core when it creates per-user agents.
EVA_LLM_BASE_URL=
EVA_LLM_API_KEY=
EVA_LLM_MODEL=mimo-v2.5-pro
# Context window advertised to Letta for the model above.
EVA_LLM_CONTEXT_WINDOW=131072
# Embedding endpoint used for Letta archival memory / recall search.
# Defaults to the same base URL when left empty.
EVA_EMBEDDING_BASE_URL=
EVA_EMBEDDING_API_KEY=
EVA_EMBEDDING_MODEL=text-embedding-3-small
EVA_EMBEDDING_DIM=1536

# ---------------------------------------------------------------------
# 4. POSTGRESQL  (GENERATED — never published outside evaself-network)
# ---------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPER_USER=postgres
POSTGRES_SUPER_PASSWORD=

EVA_DB_NAME=eva
EVA_DB_USER=eva
EVA_DB_PASSWORD=

N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=

NOCODB_DB_NAME=nocodb
NOCODB_DB_USER=nocodb
NOCODB_DB_PASSWORD=

# Kept for installations upgraded from v0.1.0: the App Server stores its
# state on disk, not in PostgreSQL, so this database is no longer written
# to. It is still dumped by `make backup` so an upgrade stays reversible.
LETTA_DB_NAME=letta
LETTA_DB_USER=letta
LETTA_DB_PASSWORD=

# Read-only role NocoDB can use for reporting views.
EVA_DB_READONLY_USER=eva_readonly
EVA_DB_READONLY_PASSWORD=

# ---------------------------------------------------------------------
# 5. VALKEY  (GENERATED — never published)
# ---------------------------------------------------------------------
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=

# ---------------------------------------------------------------------
# 6. N8N
# ---------------------------------------------------------------------
# GENERATED ONCE and then permanent: losing it makes every stored
# credential undecryptable. It is included in every backup.
N8N_ENCRYPTION_KEY=
# Shared secret between n8n and the external task runner (GENERATED).
N8N_RUNNERS_AUTH_TOKEN=
# Owner account created on first boot through the n8n setup screen.
N8N_OWNER_EMAIL=
N8N_OWNER_PASSWORD=
# Public sign-up in the editor is disabled; invites only.
N8N_DISABLE_PUBLIC_API=false
GENERIC_TIMEZONE=Europe/Amsterdam
TZ=Europe/Amsterdam
# Concurrency of the single worker (tuned for 4 vCPU / 8 GB).
N8N_WORKER_CONCURRENCY=5
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=20000

# ---------------------------------------------------------------------
# 7. LETTA APP SERVER
# ---------------------------------------------------------------------
# The self-hosted Letta App Server (`letta server --listen ws://…`).
# It is WebSocket-only, lives on evaself-network and is never published.
# This capability token is presented by eva-agent-service during the
# WebSocket upgrade (GENERATED).
LETTA_APP_SERVER_TOKEN=
# "local" keeps every agent on this server. "api" would delegate to Letta
# Cloud and is NOT what a self-hosted installation wants.
LETTA_APP_SERVER_BACKEND=local
LETTA_APP_SERVER_TIMEOUT_MS=180000
# Basic-auth pair guarding the self-hosted Letta console behind Caddy.
# The console reads through eva-agent-service; it never holds a token.
LETTA_UI_USER=admin
LETTA_UI_PASSWORD=
# bcrypt hash of LETTA_UI_PASSWORD, produced by the installer.
LETTA_UI_PASSWORD_HASH=

# ---------------------------------------------------------------------
# 8. EVA AGENT SERVICE
# ---------------------------------------------------------------------
# The TypeScript service that owns the Letta Agent SDK. n8n talks to this
# and to nothing else; it never sees the App Server.
# Internal API key n8n must present (GENERATED).
EVA_AGENT_API_KEY=
EVA_AGENT_PORT=8070
EVA_AGENT_LOG_LEVEL=info
# How long one user's turn lock may be held before it is considered stale.
EVA_AGENT_LOCK_TTL=180
# Hard ceiling for a single agent turn (milliseconds).
EVA_AGENT_TURN_TIMEOUT_MS=240000
# Persona seeded into every newly created Eva agent.
EVA_AGENT_PERSONA_FILE=/app/library/persona/eva.md

# ---------------------------------------------------------------------
# 9. NOCODB
# ---------------------------------------------------------------------
NC_ADMIN_EMAIL=
NC_ADMIN_PASSWORD=
NC_AUTH_JWT_SECRET=
# Invite-only: no open registration on the admin panel.
NC_INVITE_ONLY_SIGNUP=true
NC_DISABLE_TELE=true

# ---------------------------------------------------------------------
# 10. SEARXNG
# ---------------------------------------------------------------------
SEARXNG_SECRET=
SEARXNG_BASE_URL=http://searxng:8080/

# ---------------------------------------------------------------------
# 11. MEDIA SERVICE (ASR / TTS)
# ---------------------------------------------------------------------
# Left empty during install — the owner fills these in later.
# Any OpenAI-compatible /audio/transcriptions + /audio/speech endpoint.
MEDIA_ASR_BASE_URL=
MEDIA_ASR_API_KEY=
MEDIA_ASR_MODEL=whisper-1
MEDIA_TTS_BASE_URL=
MEDIA_TTS_API_KEY=
MEDIA_TTS_MODEL=tts-1
MEDIA_TTS_VOICE=nova
# Hard limits so a malicious upload cannot fill the disk.
MEDIA_MAX_UPLOAD_MB=50
MEDIA_MAX_AUDIO_SECONDS=1800
MEDIA_TMP_TTL_SECONDS=900

# ---------------------------------------------------------------------
# 12. OPTIONAL SERVICES
# ---------------------------------------------------------------------
# Compose profiles enabled for this installation.
# Values: "" (none), "crawl4ai", "monitoring", "crawl4ai,monitoring"
COMPOSE_PROFILES=
CRAWL4AI_API_TOKEN=

# ---------------------------------------------------------------------
# 13. BACKUP
# ---------------------------------------------------------------------
BACKUP_DIR=/var/backups/evaself
BACKUP_RETENTION_DAYS=14

# ---------------------------------------------------------------------
# 14. INSTALLATION METADATA (written by the installer, do not edit)
# ---------------------------------------------------------------------
EVASELF_INSTALL_DIR=/opt/evaself
EVASELF_INSTALLED_AT=
