# Evaself — шаблон .env
# `make install` заполняет обязательные значения и генерирует секреты.
# Итоговый файл имеет mode 600 и не должен попадать в Git.

# Служебный контур административной панели
EVA_OUTBOUND_HOST_ALLOWLIST=
EVA_HEALTH_INTERVAL_SECONDS=60
EVA_HEALTH_TIMEOUT_MS=10000

# 1. Домены
DOMAIN=
DOMAIN_APP=
DOMAIN_API=
DOMAIN_NOCODB=
DOMAIN_LETTA=
DOMAIN_STATUS=
ACME_EMAIL=
# 1 включает staging CA Let's Encrypt для проверки DNS/портов.
ACME_STAGING=0
# configure.sh пересчитывает ACME_CA из флага выше; Caddy читает ACME_CA.
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# 2. Telegram
EVA_TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
EVA_TELEGRAM_WEBHOOK_SECRET=
EVA_TELEGRAM_API_BASE_URL=https://api.telegram.org
# Окно приёма initData Telegram Mini App. Значение зажимается кодом в
# диапазон 300-600 секунд: перехваченная строка не должна оставаться
# годной час. После первой проверки клиент получает серверную сессию.
EVA_TELEGRAM_WEBAPP_MAX_AGE_SECONDS=600
# Время жизни серверной сессии Mini App, 300-3600 секунд.
EVA_WEBAPP_SESSION_TTL_SECONDS=900

# Лимиты публичных поверхностей: /public/*, /public/v2/* и webhook
# Telegram. Считаются раздельно по IP и по проверенной личности Telegram.
# 0 отключает проверку — это аварийный рычаг, а не штатная настройка.
EVA_RATE_LIMIT_WINDOW_SECONDS=60
EVA_PUBLIC_RATE_LIMIT_PER_IP=120
EVA_PUBLIC_RATE_LIMIT_PER_USER=60
EVA_WEBHOOK_RATE_LIMIT_PER_IP=600
# /health опрашивают docker healthcheck и make doctor, поэтому лимит выше
# публичного. Он всё равно нужен: маршрут ходит в Letta, PostgreSQL и Valkey.
EVA_HEALTH_RATE_LIMIT_PER_IP=300

# Раздел Security Audit в административном API. Выключен по умолчанию:
# отчёт перечисляет слабые места установки, поэтому включать его должен
# человек осознанно. На поведение самих проверок безопасности флаг не
# влияет — он управляет только доступностью отчёта.
EVA_SECURITY_AUDIT=0

# Полный административный CRUD: агенты и conversations, шаблоны memory
# block, инструменты, approvals, восстановление ходов и разделы подсистем,
# которых ещё нет. Выключен по умолчанию: раздел даёт массовые действия над
# памятью живых агентов и повтор доставки, поэтому включает его человек.
EVA_ADMIN_CRUD=0
EVA_TELEGRAM_INBOX_POLL_MS=500
EVA_TELEGRAM_INBOX_LEASE_SECONDS=300
EVA_TELEGRAM_INBOX_MAX_ATTEMPTS=5
EVA_TELEGRAM_OUTBOX_POLL_MS=500
EVA_TELEGRAM_OUTBOX_LEASE_SECONDS=120
EVA_TELEGRAM_OUTBOX_MAX_ATTEMPTS=8
EVA_PARALLEL_OUTBOX=false
EVA_OUTBOX_CONCURRENCY=8
EVA_OUTBOX_BATCH_SIZE=16
EVA_TELEGRAM_GLOBAL_RATE=25
EVA_TELEGRAM_GLOBAL_BURST=25
EVA_TELEGRAM_CHAT_RATE=1
EVA_TELEGRAM_CHAT_BURST=1

# 3. Первая OpenAI-compatible LLM-конфигурация
# После установки реестр управляется через WebUI или make configure-llm.
EVA_LLM_PROVIDER_NAME='Основной провайдер'
EVA_LLM_PROTOCOL=openai-compatible
EVA_LLM_BASE_URL=
EVA_LLM_API_KEY=
EVA_LLM_MODEL=
EVA_LLM_CONTEXT_WINDOW=32768
# request_timeout_ms настраивает Letta provider; model_settings передаётся
# существующим agents/conversations через официальный Agent SDK.
EVA_LLM_ADDITIONAL_PARAMETERS='{"request_timeout_ms":180000}'
EVA_LLM_PROBE_TIMEOUT_MS=20000
# Постоянный ключ AES-256-GCM для API keys в llm_providers.
LLM_CONFIG_ENCRYPTION_KEY=

# LLM Router. Все обращения стека к языковым моделям идут через него:
# цепочка резервов, circuit breaker и бюджеты настраиваются в админ-панели
# и применяются без перезапуска Letta App Server.
# Ключ обязателен: сеть agent общая для нескольких контейнеров.
EVA_ROUTER_API_KEY=
EVA_ROUTER_URL=http://llm-router:8073
# Сколько подряд ошибок закрывает провайдера и на сколько.
EVA_ROUTER_BREAKER_THRESHOLD=3
EVA_ROUTER_BREAKER_WINDOW_MS=300000
EVA_ROUTER_BREAKER_COOLDOWN_MS=420000
EVA_DISTRIBUTED_LIMITS=false
EVA_ROUTER_LIMIT_RESERVATION_TTL_MS=300000
EVA_ROUTER_ROUTE_MAX_CONCURRENCY=64
EVA_ROUTER_ROUTE_MAX_RPM=600
EVA_ROUTER_ROUTE_MAX_TPM=2000000
EVA_ROUTER_MAX_RETRY_AFTER_MS=5000
EVA_ROUTER_RETRY_AFTER_JITTER_MS=250

# Embeddings архивной памяти. Пустой Base URL означает endpoint LLM.
EVA_EMBEDDING_BASE_URL=
EVA_EMBEDDING_API_KEY=
EVA_EMBEDDING_MODEL=text-embedding-3-small
EVA_EMBEDDING_DIM=1536

# 4. PostgreSQL (внутренняя сеть)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPER_USER=postgres
POSTGRES_SUPER_PASSWORD=
EVA_DB_NAME=eva
EVA_DB_USER=eva
EVA_DB_PASSWORD=
NOCODB_DB_NAME=nocodb
NOCODB_DB_USER=nocodb
NOCODB_DB_PASSWORD=
# Legacy database сохраняется для обратимого обновления с 0.1.0.
LETTA_DB_NAME=letta
LETTA_DB_USER=letta
LETTA_DB_PASSWORD=
EVA_DB_READONLY_USER=eva_readonly
EVA_DB_READONLY_PASSWORD=

# 5. Valkey
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=

# 6. Встроенный runtime Евы
TZ=Europe/Amsterdam
EVA_SCHEDULER_INTERVAL_MS=30000
EVA_HEARTBEAT_INTERVAL_MS=600000
EVA_TELEGRAM_TYPING_INTERVAL_MS=4000

# 7. Self-hosted Letta App Server
LETTA_APP_SERVER_TOKEN=
LETTA_APP_SERVER_BACKEND=local
LETTA_APP_SERVER_TIMEOUT_MS=180000
LETTA_UI_USER=admin
LETTA_UI_PASSWORD=
LETTA_UI_PASSWORD_HASH=

# 8. eva-agent-service
EVA_AGENT_API_KEY=
EVA_AGENT_PORT=8070
EVA_AGENT_LOG_LEVEL=info
EVA_AGENT_LOCK_TTL=180
EVA_AGENT_TURN_TIMEOUT_MS=240000
EVA_AGENT_PERSONA_FILE=/app/library/persona/eva.md
EVA_PROFILE_COMPLETION_ENABLED=true
EVA_VECTOR_GOALS_ENABLED=true
EVA_GRAPH_MEMORY_ENABLED=true
EVA_GRAPH_CONTEXT_TIMEOUT_MS=75
EVA_PROFILE_CACHE_TTL_SECONDS=60
EVA_CONVERSATION_MIRROR_ENABLED=false
EVA_OUTBOX_ENABLED=true
# Запись жизненного цикла хода в turn_runs (shadow-режим: на ответ
# пользователю не влияет). По умолчанию выключено, включает человек.
EVA_TURN_LIFECYCLE=false
# Параллельный диспетчер durable inbox вместо последовательного воркера.
# Выключенный флаг возвращает прежний воркер, данные не меняются.
EVA_PARALLEL_INBOX=false
# Объединение быстрых последовательных сообщений одного человека в один ход.
EVA_TURN_AGGREGATION=false
# Ступени rollout параллельной обработки: 8 → 16 → 32 → 64, каждая только
# при зелёных метриках базы, провайдера и сессий.
EVA_INBOX_CONCURRENCY=8
EVA_INBOX_BATCH_SIZE=16
EVA_TURN_SLOTS_TOTAL=128
EVA_TURN_AGGREGATION_DEBOUNCE_MS=800
EVA_TURN_AGGREGATION_WINDOW_MS=2500
# Безопасный менеджер сессий: активная сессия не вытесняется и не
# закрывается, смена настроек SDK идёт через graceful drain.
EVA_SAFE_SESSION_MANAGER=false
EVA_SESSION_DRAIN_MS=8000
# Восстановление незавершённых ходов после сбоя.
EVA_TURN_RECOVERY=false
EVA_TURN_RECOVERY_INTERVAL_MS=30000
# Слой фоновых заданий на BullMQ и Valkey (очереди memory, research,
# proactive, recovery, evaluation, maintenance). Выключенный флаг не
# открывает очередей: намерения копятся в job_outbox и публикуются после
# включения. Продуктовые задачи на этот слой ещё не перенесены.
EVA_BULLMQ_JOBS=false
EVA_JOBS_OUTBOX_POLL_MS=1000
EVA_JOBS_OUTBOX_BATCH=32
# Перенос фоновых задач на очереди (шаг 08). Сверки обслуживания
# сообщений пользователю не шлют; проактивность — шлёт, поэтому она
# сначала работает в режиме зеркала: очередь только выбирает и
# сравнивает выборку со старым интервалом, отправляет прежний путь.
# Выключать EVA_JOBS_MIRROR можно лишь после совпадения выборок в
# job_mirror_samples — после этого старые интервалы не запускаются.
EVA_BULLMQ_MAINTENANCE=false
EVA_BULLMQ_PROACTIVE=false
EVA_JOBS_MIRROR=true
# Универсальный фоновый ход агента: механизм для рефлексии, отчётов и
# исследований. Сам по себе продуктовых заданий не выполняет.
EVA_AGENT_JOBS=false
# Проверять контракт Letta при старте: сверять установленную версию
# @letta-ai/letta-agent-sdk и наличие её методов с проверенной матрицей.
# Включается в canary после зелёных contract-тестов.
EVA_LETTA_SDK_060=false
# Административный control plane Letta (@letta-ai/letta-client). Диалог
# через него не идёт: он умеет только то, чего нет в Agent SDK, — прежде
# всего точечную запись memory block.
EVA_LETTA_ADMIN_CLIENT=false
# HTTP-адрес App Server для control plane. Пустой — путь недоступен, и
# запись блоков честно отмечается как runtime_override.
EVA_LETTA_ADMIN_BASE_URL=
# Локальные часы утреннего и вечернего check-in.
EVA_CHECKIN_MORNING_HOUR=9
EVA_CHECKIN_EVENING_HOUR=21
# Наблюдаемость (шаг 09). OTel заводит контекст трасс; экспортёра у него
# нет — наружу телеметрия уходит только через шлюз. Langfuse принимает
# ТОЛЬКО метаданные генерации: токены, стоимость, версии, факт
# переключения провайдера. Секрет псевдонимов заменяет идентификатор
# пользователя в телеметрии; пустой — псевдонима не будет вовсе.
EVA_OTEL=false
EVA_PROMETHEUS=true
EVA_LANGFUSE_METADATA_ONLY=false
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
EVA_TELEMETRY_PSEUDONYM_SECRET=
# Автоматическое применение политик хранения (шаг 10). Выключенный флаг
# ничего не удаляет: предпросмотр в админке работает, удаление — нет.
# Сами сроки живут в Config Service (группа «retention») и меняются в
# Admin UI в допустимых границах.
EVA_RETENTION_ENFORCEMENT=false
# Сколько ждать завершения начатых ходов при остановке сервиса.
# Значение обязано укладываться в grace period контейнера: у Docker это
# 10 секунд по умолчанию, и срок больше него наступит уже после SIGKILL.
EVA_SHUTDOWN_DRAIN_MS=8000

# 9. Отдельная административная панель
# Мастер-ключ создаётся на хосте с mode 600 и не входит в backup.
EVA_SECRETS_MASTER_KEY_FILE=
EVA_ADMIN_USERNAME=admin
# Используется только для создания первого owner, затем очищается.
EVA_ADMIN_BOOTSTRAP_PASSWORD=
EVA_ADMIN_BIND=0.0.0.0
EVA_ENV=production

# 10. Lava (необязательно)
# Webhook: https://DOMAIN_API/payments/lava, HTTP Basic Auth.
LAVA_WEBHOOK_USER=eva
LAVA_WEBHOOK_PASSWORD=
# Ключи — product ID Lava. amountMinor хранится в копейках.
LAVA_PLANS_JSON='{}'

# 11. NocoDB
NC_ADMIN_EMAIL=
NC_ADMIN_PASSWORD=
NC_AUTH_JWT_SECRET=
NC_INVITE_ONLY_SIGNUP=true
NC_DISABLE_TELE=true

# 12. SearXNG
SEARXNG_SECRET=
SEARXNG_BASE_URL=http://searxng:8080/

# Необязательная интеграция Todoist. Все задачи из общего аккаунта
# изолируются меткой eva-<Telegram ID>.
TODOIST_API_URL=https://api.todoist.com/api/v1
TODOIST_API_TOKEN=
TODOIST_PROJECT_ID=

# 13. Media Service (заполняется при подключении ASR/TTS)
#
# MEDIA_ASR_* УСТАРЕЛИ. Распознавание речи настраивается в панели:
# Распознавание речи → добавить конфигурацию. Там несколько провайдеров,
# резерв на случай отказа и смена без перезапуска контейнеров.
#
# Пока эти переменные заполнены, а в реестре нет ни одной конфигурации,
# media-service продолжает распознавать по ним — обновление работающей
# установки ничего не ломает. При первом запуске после обновления
# admin-api переносит их в реестр автоматически.
#
# Срок удаления: релиз 0.5.0. Подробности — docs/stt.md.
MEDIA_ASR_BASE_URL=
MEDIA_ASR_API_KEY=
MEDIA_ASR_MODEL=whisper-1
MEDIA_TTS_BASE_URL=
MEDIA_TTS_API_KEY=
MEDIA_TTS_MODEL=tts-1
MEDIA_TTS_VOICE=nova
# Общий секрет eva-agent-service -> media-service (заголовок X-Media-Key).
# Пустое значение отключает проверку и оставляет сервис открытым внутри сети.
MEDIA_SERVICE_TOKEN=
MEDIA_MAX_UPLOAD_MB=50
MEDIA_MAX_AUDIO_SECONDS=1800
MEDIA_TMP_TTL_SECONDS=900

# 14. Дополнительные профили: crawl4ai, monitoring
COMPOSE_PROFILES=
CRAWL4AI_API_TOKEN=

# 15. Backup
BACKUP_DIR=/var/backups/evaself
BACKUP_RETENTION_DAYS=14
# Кроме срока — ограничение по числу архивов: возраст сам по себе не
# удерживает размер каталога на маленьком диске.
BACKUP_RETENTION_COUNT=30
# Копия вне сервера. Команда получает путь к зашифрованному архиву как "$1":
#   BACKUP_UPLOAD_COMMAND='rclone copy "$1" remote:evaself/'
BACKUP_UPLOAD_COMMAND=

# 16. Метаданные установки, заполняются автоматически
EVASELF_INSTALL_DIR=/opt/evaself
EVASELF_INSTALLED_AT=
# Список пропущенных пунктов мастера; секреты сюда не попадают.
EVASELF_INCOMPLETE_SETTINGS=
