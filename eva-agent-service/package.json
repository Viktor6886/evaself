{
  "name": "eva-agent-service",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Eva's agent service — the only component that talks to the Letta App Server, through the official Letta Agent SDK.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node --watch dist/index.js",
    "test": "npm run build && node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@letta-ai/letta-agent-sdk": "0.5.5",
    "fastify": "5.10.0",
    "ioredis": "5.11.1",
    "node-pty": "1.1.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "typescript": "5.9.3"
  }
}
