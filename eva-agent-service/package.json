{
  "name": "eva-agent-service",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Eva's agent service \u2014 the only component that talks to the Letta App Server, through the official Letta Agent SDK.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node --watch dist/index.js",
    "test": "npm run build && node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@letta-ai/letta-agent-sdk": "0.6.2",
    "argon2": "^0.45.1",
    "fastify": "5.11.2",
    "ioredis": "5.11.1",
    "luxon": "3.7.2",
    "node-pty": "1.1.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/luxon": "3.7.3",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.4",
    "eslint": "^9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
