# Internal server for the Evaself Letta console.
#
# The Letta App Server speaks WebSocket only, so a browser cannot be its
# client. The console therefore reads through eva-agent-service — the same
# HTTP surface n8n uses — and Caddy adds the internal API key on the way
# out, so the key never reaches the browser and the App Server is never
# routed from the internet.
{
	auto_https off
	admin off
}

:8081 {
	handle /healthz {
		respond "ok" 200
	}

	handle_path /api/* {
		reverse_proxy {$EVA_AGENT_URL} {
			header_up X-API-Key "{$EVA_AGENT_API_KEY}"
			# an agent turn can run for minutes
			flush_interval -1
		}
	}

	handle {
		root * /srv
		encode zstd gzip
		try_files {path} {path}/ /index.html
		file_server
	}
}
