ARG N8N_IMAGE=n8nio/n8n
ARG N8N_VERSION=2.33.0
FROM ${N8N_IMAGE}:${N8N_VERSION}

# ---------------------------------------------------------------------
# Образ n8n для Evaself.
#
# ffmpeg нужен workflows для проверки/перекодирования media, curl — для
# диагностики из контейнера. Этот образ используют main и worker.
# ---------------------------------------------------------------------
USER root

# Upstream n8n сменил Alpine на Debian в пределах зафиксированной версии
# 2.33.0. Поддерживаем оба официальных base-варианта, но не пропускаем
# установку обязательных пакетов.
RUN if command -v apk >/dev/null 2>&1; then \
      apk add --no-cache ffmpeg curl tzdata; \
    elif command -v apt-get >/dev/null 2>&1; then \
      apt-get update \
      && apt-get install -y --no-install-recommends ffmpeg curl tzdata \
      && rm -rf /var/lib/apt/lists/*; \
    else \
      echo "Неподдерживаемый base image n8n: package manager не найден" >&2; \
      exit 1; \
    fi

# Встроенные модули, разрешённые Code nodes.
ENV NODE_FUNCTION_ALLOW_BUILTIN=crypto,buffer,url,querystring \
    N8N_LOG_LEVEL=info

USER node
