ARG N8N_IMAGE=n8nio/n8n
ARG N8N_VERSION=2.33.0
ARG ALPINE_VERSION=3.24

# В n8n 2.33.0 финальный образ основан на Alpine, но upstream намеренно
# удаляет apk-tools. Статический apk из той же версии Alpine позволяет
# установить runtime-пакеты, не подменяя официальный образ n8n.
FROM alpine:${ALPINE_VERSION} AS apk-provider
RUN apk add --no-cache apk-tools-static

FROM ${N8N_IMAGE}:${N8N_VERSION}

# ---------------------------------------------------------------------
# Образ n8n для Evaself.
#
# ffmpeg нужен workflows для проверки/перекодирования media, curl — для
# диагностики из контейнера. Этот образ используют main и worker.
# ---------------------------------------------------------------------
USER root

COPY --from=apk-provider /sbin/apk.static /sbin/apk
RUN apk add --no-cache ffmpeg curl tzdata \
    && rm -f /sbin/apk

# Встроенные модули, разрешённые Code nodes.
ENV NODE_FUNCTION_ALLOW_BUILTIN=crypto,buffer,url,querystring \
    N8N_LOG_LEVEL=info

USER node
