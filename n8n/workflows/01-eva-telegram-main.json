{
  "id": "evaself-telegram-main",
  "name": "Eva — Telegram main",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "eva-telegram",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Telegram webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-880, 320],
      "webhookId": "evaself-telegram-webhook",
      "notes": "Telegram calls https://{DOMAIN_N8N}/webhook/eva-telegram. scripts/telegram-webhook.sh registers it with a secret_token."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "secret-check",
              "operator": { "type": "string", "operation": "equals" },
              "leftValue": "={{ $json.headers['x-telegram-bot-api-secret-token'] }}",
              "rightValue": "={{ $env.EVA_TELEGRAM_WEBHOOK_SECRET }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Secret token valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-660, 320],
      "notes": "Rejects anything that is not Telegram calling with our secret_token."
    },
    {
      "parameters": {
        "jsCode": "// Flatten a Telegram update into the shape the rest of the flow uses.\nconst out = [];\n\nfor (const item of $input.all()) {\n  const update = item.json.body ?? item.json;\n  const message = update.message ?? update.edited_message ?? null;\n  if (!message || !message.from) continue;\n\n  const from = message.from;\n  const voice = message.voice ?? message.audio ?? null;\n\n  out.push({\n    json: {\n      update_id: update.update_id,\n      chat_id: message.chat.id,\n      message_id: message.message_id,\n      telegram_id: from.id,\n      username: from.username ?? null,\n      first_name: from.first_name ?? null,\n      last_name: from.last_name ?? null,\n      language_code: from.language_code ?? 'ru',\n      text: (message.text ?? message.caption ?? '').trim(),\n      voice_file_id: voice ? voice.file_id : null,\n      voice_duration: voice ? (voice.duration ?? 0) : 0,\n      kind: voice ? 'voice' : 'text',\n      is_command: (message.text ?? '').startsWith('/'),\n    },\n  });\n}\n\nreturn out;"
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Normalise update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-440, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVA_CORE_URL }}/v1/users/ensure",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{ $env.EVA_CORE_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ telegram_id: $json.telegram_id, username: $json.username, first_name: $json.first_name, last_name: $json.last_name, language_code: $json.language_code }) }}",
        "options": { "response": { "response": { "neverError": false } }, "timeout": 30000 }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Ensure user + agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-220, 220],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Idempotent: creates the user row and their personal Letta agent on first contact."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT metric, limit_value, used, remaining\n  FROM v_quota_status\n WHERE telegram_id = $1 AND metric = $2\n LIMIT 1;",
        "options": {
          "queryReplacement": "={{ $('Normalise update').item.json.telegram_id }},{{ $('Normalise update').item.json.kind === 'voice' ? 'voice_minutes' : 'messages' }}"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Read quota",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [0, 220],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": { "id": "evaself-postgres", "name": "Evaself PostgreSQL" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "or",
          "conditions": [
            {
              "id": "no-quota-row",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true },
              "leftValue": "={{ $json.limit_value === undefined }}"
            },
            {
              "id": "unlimited",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true },
              "leftValue": "={{ Number($json.limit_value) < 0 }}"
            },
            {
              "id": "within-limit",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true },
              "leftValue": "={{ Number($json.used || 0) < Number($json.limit_value) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Within quota?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [220, 220]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "version": 2 },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "is-voice",
                    "operator": { "type": "string", "operation": "equals" },
                    "leftValue": "={{ $('Normalise update').item.json.kind }}",
                    "rightValue": "voice"
                  }
                ]
              },
              "outputKey": "voice"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "version": 2 },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "is-text",
                    "operator": { "type": "string", "operation": "equals" },
                    "leftValue": "={{ $('Normalise update').item.json.kind }}",
                    "rightValue": "text"
                  }
                ]
              },
              "outputKey": "text"
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Voice or text?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [440, 140]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MEDIA_SERVICE_URL }}/telegram/transcribe",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ file_id: $('Normalise update').item.json.voice_file_id, language: $('Normalise update').item.json.language_code }) }}",
        "options": { "timeout": 180000 }
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Transcribe voice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 40],
      "onError": "continueRegularOutput",
      "notes": "Returns {text, duration_minutes}. duration_minutes is what the voice_minutes quota is charged with."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "text-field",
              "name": "prompt_text",
              "type": "string",
              "value": "={{ $json.text || $('Normalise update').item.json.text }}"
            },
            {
              "id": "voice-minutes",
              "name": "voice_minutes",
              "type": "number",
              "value": "={{ Math.ceil($json.duration_minutes || 0) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Prompt from voice",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, 40]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "text-field",
              "name": "prompt_text",
              "type": "string",
              "value": "={{ $('Normalise update').item.json.text }}"
            },
            {
              "id": "voice-minutes",
              "name": "voice_minutes",
              "type": "number",
              "value": 0
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-00000000000a",
      "name": "Prompt from text",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVA_CORE_URL }}/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{ $env.EVA_CORE_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ telegram_id: $('Normalise update').item.json.telegram_id, text: $json.prompt_text, metric: $('Normalise update').item.json.kind === 'voice' ? 'voice_minutes' : 'messages' }) }}",
        "options": { "timeout": 240000, "response": { "response": { "neverError": true, "fullResponse": true } } }
      },
      "id": "a1000000-0000-4000-8000-00000000000b",
      "name": "Ask Eva (Letta)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 140],
      "notes": "Eva Core holds a per-user lock for the whole turn; a 409 here means the user sent a second message while the first was still running."
    },
    {
      "parameters": {
        "jsCode": "// Turn Eva Core's answer (or its error envelope) into a Telegram reply.\nconst source = $('Normalise update').first().json;\nconst out = [];\n\nfor (const item of $input.all()) {\n  const status = item.json.statusCode ?? 200;\n  const body = item.json.body ?? item.json;\n\n  let reply;\n  if (status >= 200 && status < 300) {\n    reply = (body.reply || '').trim() || 'Я тебя услышала, но не нашла, что ответить. Попробуй переформулировать.';\n  } else if (body?.error?.code === 'user_busy') {\n    reply = 'Секунду — я ещё отвечаю на предыдущее сообщение.';\n  } else if (body?.error?.retryable) {\n    reply = 'Сейчас не получается ответить, сервис временно недоступен. Попробуй, пожалуйста, через минуту.';\n  } else {\n    reply = 'Что-то пошло не так на моей стороне. Я записала ошибку, попробуй ещё раз чуть позже.';\n  }\n\n  out.push({\n    json: {\n      chat_id: source.chat_id,\n      reply,\n      status,\n      error_code: body?.error?.code ?? null,\n      telegram_id: source.telegram_id,\n    },\n  });\n}\n\nreturn out;"
      },
      "id": "a1000000-0000-4000-8000-00000000000c",
      "name": "Build reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 140]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "quota-reply",
              "name": "reply",
              "type": "string",
              "value": "На сегодня лимит исчерпан. Он обновится завтра — или можно расширить его в подписке."
            },
            {
              "id": "quota-chat",
              "name": "chat_id",
              "type": "number",
              "value": "={{ $('Normalise update').item.json.chat_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-00000000000d",
      "name": "Quota exceeded reply",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.EVA_TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, text: $json.reply, parse_mode: 'HTML', disable_web_page_preview: true }) }}",
        "options": { "timeout": 30000 }
      },
      "id": "a1000000-0000-4000-8000-00000000000e",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 220],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {},
      "id": "a1000000-0000-4000-8000-00000000000f",
      "name": "Drop (bad secret)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [-440, 460]
    }
  ],
