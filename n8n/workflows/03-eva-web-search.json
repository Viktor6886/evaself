{
  "id": "evaself-web-search",
  "name": "Eva — Web search",
  "active": false,
  "settings": { "executionOrder": "v1", "saveManualExecutions": true },
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            { "name": "query", "type": "string" },
            { "name": "telegram_id", "type": "number" },
            { "name": "fetch_pages", "type": "boolean" }
          ]
        }
      },
      "id": "c3000000-0000-4000-8000-000000000001",
      "name": "Called by another workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-660, 300],
      "notes": "Sub-workflow. Input: {query, telegram_id, fetch_pages}."
    },
    {
      "parameters": {
        "url": "={{ $env.SEARXNG_URL }}/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "q", "value": "={{ $json.query }}" },
            { "name": "format", "value": "json" },
            { "name": "safesearch", "value": "1" },
            { "name": "language", "value": "auto" }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "c3000000-0000-4000-8000-000000000002",
      "name": "Search (SearXNG)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-440, 300],
      "retryOnFail": true,
      "maxTries": 2,
      "notes": "SearXNG runs inside evaself-network and is never published."
    },
    {
      "parameters": {
        "jsCode": "// Keep the top results and a compact, model-friendly summary.\nconst MAX = 6;\nconst out = [];\n\nfor (const item of $input.all()) {\n  const results = (item.json.results || []).slice(0, MAX).map((r) => ({\n    title: r.title,\n    url: r.url,\n    snippet: (r.content || '').slice(0, 400),\n    engine: r.engine,\n  }));\n\n  out.push({\n    json: {\n      query: item.json.query ?? $('Called by another workflow').first().json.query,\n      count: results.length,\n      results,\n      summary: results\n        .map((r, i) => `${i + 1}. ${r.title}\\n${r.url}\\n${r.snippet}`)\n        .join('\\n\\n'),\n    },\n  });\n}\n\nreturn out;"
      },
      "id": "c3000000-0000-4000-8000-000000000003",
      "name": "Shape results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "wants-pages",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true },
              "leftValue": "={{ $('Called by another workflow').first().json.fetch_pages === true }}"
            }
          ]
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000004",
      "name": "Fetch full pages?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [0, 300],
      "notes": "Only when the optional crawl4ai profile is installed."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRAWL4AI_URL }}/md",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.CRAWL4AI_API_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $json.results[0].url, f: 'fit' }) }}",
        "options": { "timeout": 60000, "response": { "response": { "neverError": true } } }
      },
      "id": "c3000000-0000-4000-8000-000000000005",
      "name": "Clean page (Crawl4AI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 220],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Return one object to the calling workflow.\nconst base = $('Shape results').first().json;\nlet page = null;\n\ntry {\n  const fetched = $input.first().json;\n  page = fetched?.markdown ?? fetched?.result?.markdown ?? null;\n} catch (error) {\n  page = null;\n}\n\nreturn [{ json: { ...base, page_markdown: page ? String(page).slice(0, 20000) : null } }];"
      },
      "id": "c3000000-0000-4000-8000-000000000006",
      "name": "Return to caller",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    }
  ],
  "connections": {
    "Called by another workflow": {
      "main": [[{ "node": "Search (SearXNG)", "type": "main", "index": 0 }]]
    },
    "Search (SearXNG)": {
      "main": [[{ "node": "Shape results", "type": "main", "index": 0 }]]
    },
    "Shape results": {
      "main": [[{ "node": "Fetch full pages?", "type": "main", "index": 0 }]]
    },
    "Fetch full pages?": {
      "main": [
        [{ "node": "Clean page (Crawl4AI)", "type": "main", "index": 0 }],
        [{ "node": "Return to caller", "type": "main", "index": 0 }]
      ]
    },
    "Clean page (Crawl4AI)": {
      "main": [[{ "node": "Return to caller", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {},
  "tags": [{ "id": "evaself", "name": "evaself" }]
}
