# =====================================================================
# Evaself — зафиксированные версии сервисов
# ---------------------------------------------------------------------
# Здесь перечислены все теги образов из compose.yaml. Плавающие теги
# latest/stable не используются: установку можно воспроизвести, а
# `make rollback` возвращает точное предыдущее состояние.
#
# `make update-preview` показывает разницу с новыми стабильными версиями,
# не меняя систему. `make update` обновляет этот файл и перезапускает стек.
#
# Проверено по upstream-реестрам 2026-07-29.
# =====================================================================

# --- слой данных ------------------------------------------------------
# Образ pgvector содержит PostgreSQL и нужное Letta векторное расширение.
# Основная версия PostgreSQL автоматически не обновляется (scripts/update.sh).
POSTGRES_IMAGE=pgvector/pgvector
POSTGRES_VERSION=0.8.6-pg17
POSTGRES_MAJOR=17

VALKEY_IMAGE=valkey/valkey
VALKEY_VERSION=9.1.1-alpine

# --- входной прокси ---------------------------------------------------
CADDY_IMAGE=caddy
CADDY_VERSION=2.11.4-alpine

# --- агенты -----------------------------------------------------------
# Letta App Server — режим Letta Code CLI из npm, поэтому фиксируется
# версия пакета, а не тег образа. Версии SDK и letta-code согласованы:
# @letta-ai/letta-agent-sdk 0.5.5 зависит от @letta-ai/letta-code 0.29.9.
LETTA_AGENT_SDK_VERSION=0.5.5
LETTA_CODE_VERSION=0.29.9

# --- административный интерфейс данных --------------------------------
NOCODB_IMAGE=nocodb/nocodb
NOCODB_VERSION=2026.07.0

# --- поиск ------------------------------------------------------------
SEARXNG_IMAGE=searxng/searxng
SEARXNG_VERSION=2026.7.26-b060c780d

# --- дополнительные профили -------------------------------------------
CRAWL4AI_IMAGE=unclecode/crawl4ai
CRAWL4AI_VERSION=0.9.2

UPTIME_KUMA_IMAGE=louislam/uptime-kuma
UPTIME_KUMA_VERSION=2.4.0

# --- базовые образы локальной сборки ----------------------------------
PYTHON_BASE_VERSION=3.12-slim-bookworm
# Agent SDK требует Node >= 22.19. Debian нужен для нативного node-pty:
# пакет не публикует готовую musl-сборку для Alpine.
NODE_BASE_VERSION=22.22-bookworm-slim

# --- компоненты на хосте ----------------------------------------------
