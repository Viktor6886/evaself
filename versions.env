# =====================================================================
# Evaself — pinned service versions
# ---------------------------------------------------------------------
# Every image tag used by compose.yaml lives here. Nothing in the stack
# uses a floating "latest"/"stable" tag, so an installation is fully
# reproducible and `make rollback` can restore an exact previous state.
#
# `make update-preview` compares these values against the newest stable
# upstream releases and prints a diff without touching the system.
# `make update` rewrites this file, then restarts the stack.
#
# Checked against upstream registries on 2026-07-28.
# =====================================================================

# --- data layer -------------------------------------------------------
# pgvector image = PostgreSQL + the vector extension Letta requires.
# MAJOR VERSION IS NEVER BUMPED AUTOMATICALLY (see scripts/update.sh).
POSTGRES_IMAGE=pgvector/pgvector
POSTGRES_VERSION=0.8.5-pg17
POSTGRES_MAJOR=17

VALKEY_IMAGE=valkey/valkey
VALKEY_VERSION=9.1.1-alpine

# --- edge -------------------------------------------------------------
CADDY_IMAGE=caddy
CADDY_VERSION=2.11.4-alpine

# --- automation -------------------------------------------------------
# n8n and the external task runner MUST share the same version.
N8N_IMAGE=n8nio/n8n
N8N_VERSION=2.33.0
N8N_RUNNERS_IMAGE=n8nio/runners
N8N_RUNNERS_VERSION=2.33.0

# --- agents -----------------------------------------------------------
# The Letta App Server is a mode of the Letta Code CLI, distributed on npm,
# so it is pinned by package version rather than by image tag. The Agent
# SDK pins an exact letta-code version of its own; keep these two in step
# (@letta-ai/letta-agent-sdk 0.5.2 depends on @letta-ai/letta-code 0.29.8).
LETTA_AGENT_SDK_VERSION=0.5.2
LETTA_CODE_VERSION=0.29.8

# --- admin / data GUI -------------------------------------------------
NOCODB_IMAGE=nocodb/nocodb
NOCODB_VERSION=2026.07.0

# --- search -----------------------------------------------------------
SEARXNG_IMAGE=searxng/searxng
SEARXNG_VERSION=2026.7.26-b060c780d

# --- optional profiles ------------------------------------------------
CRAWL4AI_IMAGE=unclecode/crawl4ai
CRAWL4AI_VERSION=0.9.2

UPTIME_KUMA_IMAGE=louislam/uptime-kuma
UPTIME_KUMA_VERSION=2.4.0

# --- base images for locally built services --------------------------
PYTHON_BASE_VERSION=3.12-slim-bookworm
# The Agent SDK requires Node >= 22.19.
NODE_BASE_VERSION=22.22-alpine

# --- host-installed components ---------------------------------------
# Hermes Agent is installed directly into Ubuntu, not into Docker.
HERMES_INSTALL_URL=https://hermes-agent.nousresearch.com/install.sh
